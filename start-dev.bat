@echo off
setlocal
title Smart Dispatch - dev launcher
cd /d "%~dp0"

rem ============ Settings ============
rem Android emulator to start (Android Studio > Device Manager). Leave empty to skip the emulator.
set "AVD_NAME=Pixel_10a"
rem DNS servers for the emulator so it always has internet.
set "EMULATOR_DNS=8.8.8.8,1.1.1.1"
rem Software rendering: with the host GPU, Expo Go showed a black screen on this PC.
rem Change to "host" for more speed if your graphics driver handles it.
set "EMULATOR_GPU=swiftshader_indirect"
rem ==================================

echo.
echo  ==========================================
echo    Smart Dispatch - local development
echo  ==========================================
echo.

rem --- Find this PC's Wi-Fi/LAN IP so a phone on the same network can reach the backend ---
set "LANIP="
for /f "usebackq delims=" %%i in (`powershell -NoProfile -Command "(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notmatch 'vEthernet|Loopback|WSL|VirtualBox|VMware' -and $_.IPAddress -notlike '169.254.*' -and $_.IPAddress -ne '127.0.0.1' } | Sort-Object InterfaceMetric | Select-Object -First 1).IPAddress"`) do set "LANIP=%%i"
if "%LANIP%"=="" set "LANIP=127.0.0.1"
echo  LAN IP: %LANIP%

rem --- Point the mobile app at the backend on this IP (mobile\.env.local is gitignored) ---
(
  echo # Generated by start-dev.bat - phone on the same Wi-Fi reaches the backend through this PC.
  echo EXPO_PUBLIC_API_BASE_URL=http://%LANIP%:8000
  echo EXPO_PUBLIC_POLL_INTERVAL=4000
  echo EXPO_PUBLIC_MAP_DEFAULT_LAT=41.7151
  echo EXPO_PUBLIC_MAP_DEFAULT_LNG=44.8271
) > "mobile\.env.local"

rem --- Install dependencies the first time ---
if not exist "web\node_modules" (
  echo  Installing web packages...
  pushd web & call npm install & popd
)
if not exist "mobile\node_modules" (
  echo  Installing mobile packages...
  pushd mobile & call npm install & popd
)

rem --- Start each service in its own window (close a window to stop that service) ---
echo  Starting backend  ^(http://%LANIP%:8000^)...
rem APP_URL makes image/media links point at this PC instead of "localhost" (so phones/emulators can load them).
rem ("php artisan serve" drops custom env vars like APP_URL, so the built-in server is started directly with Laravel's router.)
set "APP_URL=http://%LANIP%:8000"
start "Smart Dispatch - Backend" cmd /k "cd /d "%~dp0backend" && php artisan migrate --force && php artisan storage:link >nul 2>&1 & cd public && php -S 0.0.0.0:8000 ..\vendor\laravel\framework\src\Illuminate\Foundation\resources\server.php"

echo  Starting web      ^(http://localhost:5173^)...
start "Smart Dispatch - Web" cmd /k "cd /d "%~dp0web" && npm run dev -- --host"

rem --- Android emulator (Android Studio) with its own DNS so it has internet ---
set "ANDROID_HOME=%ANDROID_HOME%"
if "%ANDROID_HOME%"=="" set "ANDROID_HOME=%LOCALAPPDATA%\Android\Sdk"
set "PATH=%ANDROID_HOME%\platform-tools;%ANDROID_HOME%\emulator;%PATH%"
set "EXPO_FLAGS=-c"

if "%AVD_NAME%"=="" goto start_mobile
if not exist "%ANDROID_HOME%\emulator\emulator.exe" (
  echo  Android SDK not found at %ANDROID_HOME% - skipping the emulator.
  goto start_mobile
)

adb start-server >nul 2>&1
adb devices | findstr /r /c:"^emulator-.*device$" >nul
if not errorlevel 1 (
  echo  Android emulator already running.
  goto emulator_ready
)

echo  Starting Android emulator %AVD_NAME% ^(DNS %EMULATOR_DNS%, GPU %EMULATOR_GPU%^)...
start "Android Emulator" "%ANDROID_HOME%\emulator\emulator.exe" -avd %AVD_NAME% -dns-server %EMULATOR_DNS% -gpu %EMULATOR_GPU%

echo  Waiting for Android to boot ^(first boot can take a minute^)...
adb wait-for-device
:wait_boot
set "BOOTED="
for /f "usebackq delims=" %%b in (`adb shell getprop sys.boot_completed 2^>nul`) do set "BOOTED=%%b"
if not "%BOOTED%"=="1" (
  timeout /t 2 /nobreak >nul
  goto wait_boot
)
echo  Android emulator is ready.

:emulator_ready
rem Open the app on the emulator automatically.
set "EXPO_FLAGS=-c --android"

:start_mobile
echo  Starting mobile   ^(Expo^)...
start "Smart Dispatch - Mobile" cmd /k "cd /d "%~dp0mobile" && npx expo start %EXPO_FLAGS%"

rem --- Open the web app once Vite is up ---
timeout /t 6 /nobreak >nul
start "" "http://localhost:5173"

echo.
echo  All set:
echo    Web      http://localhost:5173
echo    Backend  http://%LANIP%:8000
echo    Mobile   opens on the Android emulator; on a phone, scan the QR code
echo             in the "Mobile" window with Expo Go ^(same Wi-Fi^)
echo.
echo  Close the windows to stop everything.
echo  Want the same demo data as the online demo? Run reset-demo-data.bat
echo.
pause
